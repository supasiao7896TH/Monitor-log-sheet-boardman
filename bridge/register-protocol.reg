@="URL:Plant Log Bridge Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\plantlogbridge\shell]

[HKEY_CURRENT_USER\Software\Classes\plantlogbridge\shell\open]

